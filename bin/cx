#!/usr/bin/env bash

set -euo pipefail

DEFAULT_MODEL="${CX_DEFAULT_MODEL:-gpt-5.4}"
DEFAULT_REASONING="${CX_DEFAULT_REASONING:-medium}"
DEFAULT_YOLO="${CX_DEFAULT_YOLO:-yes}"

MODEL_OPTIONS=(
  "gpt-5.4"
  "gpt-5.5"
  "gpt-5.3-codex"
  "gpt-5.2-codex"
  "gpt-5.1-codex-max"
  "gpt-5.2"
  "gpt-5.1-codex-mini"
  "custom"
)

PICK_BACK="__CX_BACK__"
PICK_CANCELLED="__CX_CANCELLED__"
BACK_OPTION_LABEL="返回上一步"

# ---- Help ----
print_help() {
  cat <<'EOF'
用法:
  cx                    打开交互式启动菜单
  cx menu               强制打开交互式启动菜单
  cx low                直接使用 low 思考等级启动
  cx medium             直接使用 medium 思考等级启动
  cx high               直接使用 high 思考等级启动
  cx yolo               跳过 yolo 选择，默认开启 yolo
  cx no-yolo            跳过 yolo 选择，并显式关闭 yolo
  cx gpt-5.5            跳过 model 选择
  cx gpt-5.4            跳过 model 选择
  cx xhigh yolo         直接使用 xhigh + yolo 启动
  cx low --model o3     使用自定义 model 启动
  cx --help             查看帮助

----

默认值:
  - 思考等级: `medium`
  - yolo: `yes`
  - model: `gpt-5.4`

说明:
  - 传了什么参数，就跳过对应的菜单
  - 检测到 `fzf` 时默认启用增强交互，否则回退到基础菜单
  - 基础菜单里输入 `b` 或 `back` 可返回上一步
  - `fzf` 菜单里按 `ctrl-b` 或选择 `返回上一步` 可返回上一步
  - `yolo` 实际映射到 `--dangerously-bypass-approvals-and-sandbox`
  - 未识别的参数会原样透传给 `codex`
EOF
}

has_fzf() {
  command -v fzf >/dev/null 2>&1
}

build_fzf_args() {
  FZF_ARGS=()
  FZF_ENV_DEFAULT_OPTS=""
  FZF_ENV_DEFAULT_OPTS_FILE=""

  if [[ "${CX_FZF_INHERIT_ALL:-0}" == "1" ]]; then
    if [[ -n "${FZF_DEFAULT_OPTS:-}" ]]; then
      eval "FZF_ARGS=($FZF_DEFAULT_OPTS)"
    fi

    FZF_ENV_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-}"
    FZF_ENV_DEFAULT_OPTS_FILE="${FZF_DEFAULT_OPTS_FILE:-}"
    return 0
  fi

  if [[ -z "${FZF_DEFAULT_OPTS:-}" ]]; then
    return 0
  fi

  local -a raw_args=()
  local -a sanitized_args=()
  local arg=""
  local skip_next="0"

  eval "raw_args=($FZF_DEFAULT_OPTS)"

  for arg in "${raw_args[@]}"; do
    if [[ "$skip_next" == "1" ]]; then
      skip_next="0"
      continue
    fi

    case "$arg" in
      --preview)
        skip_next="1"
        ;;
      --preview=*)
        ;;
      *)
        sanitized_args+=("$arg")
        ;;
    esac
  done

  FZF_ARGS=("${sanitized_args[@]}")
}

is_model_option() {
  local candidate="$1"
  local option

  for option in "${MODEL_OPTIONS[@]}"; do
    if [[ "$candidate" == "$option" ]]; then
      return 0
    fi
  done

  return 1
}

# ---- Pickers ----
pick_with_fzf() {
  local prompt="$1"
  local allow_back="${2:-0}"
  shift 2
  local options=("$@")
  local output=""
  local selected=""
  local key=""
  local -a cmd

  if [[ "$allow_back" == "1" ]]; then
    options+=("$BACK_OPTION_LABEL")
  fi

  build_fzf_args

  cmd=(fzf)

  if ((${#FZF_ARGS[@]} > 0)); then
    cmd+=("${FZF_ARGS[@]}")
  fi

  cmd+=(
    --height=40%
    --layout=reverse
    --border
    --cycle
    --prompt="${prompt}: "
  )

  if [[ "$allow_back" == "1" ]]; then
    cmd+=(--expect=ctrl-b)
  fi

  if ! output="$(printf '%s\n' "${options[@]}" | env \
    FZF_DEFAULT_OPTS="$FZF_ENV_DEFAULT_OPTS" \
    FZF_DEFAULT_OPTS_FILE="$FZF_ENV_DEFAULT_OPTS_FILE" \
    "${cmd[@]}")"; then
    printf '%s\n' "$PICK_CANCELLED"
    return 0
  fi

  if [[ "$allow_back" == "1" ]]; then
    if [[ "$output" == *$'\n'* ]]; then
      key="${output%%$'\n'*}"
      selected="${output#*$'\n'}"
    elif [[ "$output" == "ctrl-b" ]]; then
      key="ctrl-b"
    else
      selected="$output"
    fi

    if [[ "$key" == "ctrl-b" ]]; then
      printf '%s\n' "$PICK_BACK"
      return 0
    fi
  else
    selected="$output"
  fi

  if [[ -z "$selected" ]]; then
    printf '%s\n' "$PICK_CANCELLED"
    return 0
  fi

  if [[ "$allow_back" == "1" && "$selected" == "$BACK_OPTION_LABEL" ]]; then
    printf '%s\n' "$PICK_BACK"
    return 0
  fi

  printf '%s\n' "$selected"
}

pick_with_select() {
  local prompt="$1"
  local allow_back="${2:-0}"
  shift 2
  local options=("$@")
  local choice=""

  if [[ "$allow_back" == "1" ]]; then
    options+=("$BACK_OPTION_LABEL")
  fi

  printf '%s\n' "$prompt" >&2
  select choice in "${options[@]}"; do
    if [[ "$allow_back" == "1" ]]; then
      case "$REPLY" in
        b|back)
          printf '%s\n' "$PICK_BACK"
          return 0
          ;;
      esac
    fi

    if [[ -n "$choice" ]]; then
      if [[ "$allow_back" == "1" && "$choice" == "$BACK_OPTION_LABEL" ]]; then
        printf '%s\n' "$PICK_BACK"
        return 0
      fi

      printf '%s\n' "$choice"
      return 0
    fi

    echo "无效选择" >&2
  done

  printf '%s\n' "$PICK_CANCELLED"
}

pick_one() {
  local prompt="$1"
  local allow_back="${2:-0}"
  shift 2

  if has_fzf; then
    pick_with_fzf "$prompt" "$allow_back" "$@"
    return 0
  fi

  pick_with_select "$prompt" "$allow_back" "$@"
}

pick_default_first() {
  local prompt="$1"
  local allow_back="$2"
  local preferred="$3"
  shift 3
  local -a options=("$preferred")
  local option=""

  for option in "$@"; do
    if [[ "$option" == "$preferred" ]]; then
      continue
    fi

    options+=("$option")
  done

  pick_one "$prompt" "$allow_back" "${options[@]}"
}

pick_model() {
  local allow_back="${1:-0}"
  local selected=""

  while true; do
    selected="$(pick_one "Model" "$allow_back" "${MODEL_OPTIONS[@]}")" || return 130

    if [[ "$selected" == "$PICK_BACK" || "$selected" == "$PICK_CANCELLED" ]]; then
      printf '%s\n' "$selected"
      return 0
    fi

    if [[ "$selected" != "custom" ]]; then
      printf '%s\n' "$selected"
      return 0
    fi

    printf '请输入自定义 model: ' >&2

    if ! IFS= read -r selected; then
      printf '%s\n' "$PICK_CANCELLED"
      return 0
    fi

    case "$selected" in
      b|back)
        continue
        ;;
    esac

    if [[ -z "$selected" ]]; then
      echo "model 不能为空" >&2
      return 1
    fi

    printf '%s\n' "$selected"
    return 0
  done
}

# ---- Launch ----
launch_codex() {
  local reasoning="$1"
  local yolo_enabled="$2"
  local model="$3"
  local effort=""
  shift 3

  case "$reasoning" in
    low)
      effort="low"
      ;;
    medium)
      effort="medium"
      ;;
    high)
      effort="high"
      ;;
    xhigh)
      effort="xhigh"
      ;;
    *)
      echo "不支持的思考等级: $reasoning" >&2
      return 1
      ;;
  esac

  if ! command -v codex >/dev/null 2>&1; then
    echo "未找到 codex，请先安装 Codex CLI" >&2
    return 1
  fi

  local -a cmd
  cmd=(codex --model "$model" -c "model_reasoning_effort=\"$effort\"")

  if [[ "$yolo_enabled" == "1" ]]; then
    cmd+=(--dangerously-bypass-approvals-and-sandbox)
  fi

  if (($# > 0)); then
    cmd+=("$@")
  fi

  exec "${cmd[@]}"
}

# ---- Dynamic menus ----
open_menu() {
  local reasoning="${1:-}"
  local yolo_state="${2:-}"
  local model="${3:-}"
  local yolo_enabled="0"
  local -a interactive_steps=()
  local step_index="0"
  local allow_back="0"
  local step=""
  local result=""
  shift 3

  if [[ -z "$reasoning" ]]; then
    interactive_steps+=("reasoning")
  fi

  if [[ -z "$yolo_state" ]]; then
    interactive_steps+=("yolo")
  fi

  if [[ -z "$model" ]]; then
    interactive_steps+=("model")
  fi

  while ((step_index < ${#interactive_steps[@]})); do
    step="${interactive_steps[$step_index]}"
    allow_back="0"

    if ((step_index > 0)); then
      allow_back="1"
    fi

    case "$step" in
      reasoning)
        result="$(pick_default_first "思考等级" "$allow_back" "$DEFAULT_REASONING" low medium high xhigh)" || return 130
        ;;
      yolo)
        result="$(pick_default_first "Yolo" "$allow_back" "$DEFAULT_YOLO" yes no)" || return 130
        ;;
      model)
        result="$(pick_model "$allow_back")" || return 130
        ;;
      *)
        echo "未知菜单步骤: $step" >&2
        return 1
        ;;
    esac

    case "$result" in
      "$PICK_BACK")
        ((step_index--))
        ;;
      "$PICK_CANCELLED")
        return 130
        ;;
      *)
        case "$step" in
          reasoning)
            reasoning="$result"
            ;;
          yolo)
            yolo_state="$result"
            ;;
          model)
            model="$result"
            ;;
        esac

        ((step_index++))
        ;;
    esac
  done

  if [[ "$yolo_state" == "yes" ]]; then
    yolo_enabled="1"
  fi

  launch_codex "$reasoning" "$yolo_enabled" "$model" "$@"
}

# ---- Main ----
main() {
  local reasoning=""
  local yolo_state=""
  local model=""
  local menu_mode="0"
  local yolo_enabled="0"
  local -a passthrough=()

  while (($# > 0)); do
    case "$1" in
      low|medium|high|xhigh)
        reasoning="$1"
        shift
        ;;
      yolo)
        yolo_state="yes"
        shift
        ;;
      no-yolo)
        yolo_state="no"
        shift
        ;;
      menu)
        menu_mode="1"
        shift
        ;;
      -m|--model)
        if (($# < 2)); then
          echo "$1 缺少值" >&2
          return 1
        fi
        model="$2"
        shift 2
        ;;
      --model=*)
        model="${1#--model=}"
        shift
        ;;
      -h|--help)
        print_help
        return 0
        ;;
      --)
        shift
        passthrough+=("$@")
        break
        ;;
      *)
        if is_model_option "$1"; then
          model="$1"
        else
          passthrough+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [[ -n "$reasoning" && -n "$yolo_state" && -n "$model" && "$menu_mode" != "1" ]]; then
    if [[ "$yolo_state" == "yes" ]]; then
      yolo_enabled="1"
    fi

    if ((${#passthrough[@]} > 0)); then
      launch_codex "$reasoning" "$yolo_enabled" "$model" "${passthrough[@]}"
    else
      launch_codex "$reasoning" "$yolo_enabled" "$model"
    fi

    return 0
  fi

  if ((${#passthrough[@]} > 0)); then
    open_menu "$reasoning" "$yolo_state" "$model" "${passthrough[@]}"
  else
    open_menu "$reasoning" "$yolo_state" "$model"
  fi
}

main "$@"
